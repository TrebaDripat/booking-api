    "/metrics": {
      "get": {
        "operationId": "OperationsController_scrape",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Operations"
        ]
      }
    }
  },
  "info": {
    "title": "Booking API",
    "description": "Local room reservation demo. Intervals include the start and exclude the end. All instants require a time zone.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ProblemDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 409
          },
          "code": {
            "type": "string",
            "example": "slot_unavailable"
          },
          "message": {
            "type": "string",
            "example": "This resource already has an overlapping booking"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "ResourceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AvailabilityDto": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "example": "2030-06-03T09:00:00Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "example": "2030-06-03T10:00:00Z"
          },
          "resourceId": {
            "type": "string",
            "format": "uuid",
            "example": "10000000-0000-4000-8000-000000000001"
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "resourceId",
          "available"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "example": "2030-06-03T09:00:00Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "example": "2030-06-03T10:00:00Z"
          },
          "resourceId": {
            "type": "string",
            "format": "uuid",
            "example": "10000000-0000-4000-8000-000000000001"
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "resourceId"
        ],
        "additionalProperties": false
      },
      "BookingDto": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "example": "2030-06-03T09:00:00Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "example": "2030-06-03T10:00:00Z"
          },
          "resourceId": {
            "type": "string",
            "format": "uuid",
            "example": "10000000-0000-4000-8000-000000000001"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "resourceId",
          "id",
          "createdAt",
          "cancelledAt"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
